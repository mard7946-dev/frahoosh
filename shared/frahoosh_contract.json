{
  "version": "2.0.0",
  "source": "Frahoosh Web V16.12 FINAL STABLE TABLES",
  "backend": "supabase",
  "clients": ["web", "android"],
  "principle": "Web and Android must use the same Supabase tables, field names, identity links, role model and workflows. Local SQLite is a migration/source artifact, not a second live backend.",
  "auth": {
    "provider": "supabase_auth",
    "password_storage": "never_store_plaintext_in_domain_tables"
  },
  "core_tables": {
    "users": ["id","username","role","permissions","linked_student_id","linked_teacher_id","linked_staff_id","display_name"],
    "account_settings": ["username","display_name","phone","email","preferences","updated_at","national_code"],
    "students": ["id","first_name","last_name","national_code","student_code","grade","class_name","phone","parent_phone","photo","father_name","mother_name","birth_date","email","address","description","nationality","religion","sect"],
    "teachers": ["id","first_name","last_name","national_code","phone","email","subject","grades","description","source_staff_id","mobile","lessons","employment_status","employee_code"],
    "staff": ["id","first_name","last_name","role","phone","description","work_experience","employee_code","national_code","religion","sect","children_count","employment_status","teaching_hours"],
    "parent_children": ["parent_username","student_id"],
    "attendance": ["id","student_id","date","status","description","teacher_id","subject","class_name","attendance_date"],
    "grades": ["id","student_id","teacher_id","subject","exam_name","score","description","created_at","grade_type","term","max_score","grade_date","title","assessment_date"],
    "student_grades": ["id","student_id","teacher_id","subject","class_name","assessment_type","assessment_title","score","coefficient","grade_date","grade_date_shamsi","description","term","created_at","updated_at","manager_released"],
    "assignments": ["id","student_id","teacher_id","title","description","status","created_at","due_date","subject","class_name"],
    "teacher_classes": ["id","teacher_id","teacher_name","subject","grade","class_name","active","created_at"],
    "weekly_schedule": ["id","teacher","hours","grade","class_count","subject","bell_pattern","class_names","created_at","teacher_id","weekdays"],
    "exam_schedule": ["id","subject","grade","start_date","end_date","weight","exam_date","duration","exam_start_time","exam_end_time","created_at"],
    "online_classes": ["id","title","subject","lesson","teacher","grade","class_name","duration","pages","record","smart_board","quiz","camera","microphone","start_time","end_time","status","created_at","created_at_shamsi","start_time_shamsi","end_time_shamsi"],
    "online_class_sessions": ["id","class_id","started_at","ended_at","created_at"],
    "online_class_students": ["id","class_id","student_id","student_name"],
    "online_class_teachers": ["id","class_id","teacher_id","teacher_name"],
    "online_attendance": ["id","class_id","student_id","join_time","leave_time","status","last_activity"],
    "messages": ["id","sender","receiver","text","created_at","sender_user_id","sender_name","title","body","audience_type","audience_value"],
    "message_targets": ["id","message_id","target_type","target_value","created_at","target_role","target_id","read_at"],
    "finance_accounts": ["id","title","balance","created_at"],
    "finance_transactions": ["id","transaction_type","title","amount","category","description","transaction_date"],
    "payment_offers": ["id","title","amount","target_type","target_value","description","active","manual_amount","created_at","created_at_shamsi"],
    "payment_attempts": ["id","offer_id","student_id","payer_username","payer_role","amount","masked_card","status","gateway_ref","description","created_at","created_at_shamsi"],
    "payment_records": ["id","student_id","parent_username","title","amount","payment_type","gateway","authority","reference","status","payment_date","description","payment_date_shamsi","parent_name","created_at"],
    "report_cards": ["id","student_id","term","average","description","created_at","grade_level","academic_year","report_date"],
    "school_profile": ["id","school_name","school_code","principal_name","phone","address","academic_year","logo_path","updated_at","request_date_shamsi"],
    "school_class_config": ["id","total_classes","grade7_classes","grade8_classes","grade9_classes","updated_at"]
  },
  "integration_rules": {
    "rtl": true,
    "real_data_only": true,
    "no_course_selection": true,
    "payment_label": "کمک‌های داوطلبانه",
    "access_denied_text": "شما دسترسی به این قسمت را ندارید",
    "web_sqlite_is_not_a_live_second_backend": true
  }
}